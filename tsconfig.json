{
  "extends": "zotero-types/entries/sandbox/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "typings"
  ],
  "exclude": [
    "addon",
    "**/temp**"
  ]
}
